{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/coverage",
      "!**/next-env.d.ts",
      "!**/apps/auth/src/account",
      "!**/apps/auth/src/admin",
      "!**/apps/auth/src/shared",
      "!**/apps/auth/src/kc.gen.tsx",
      "!**/apps/auth/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "options": {
            "functions": ["cn", "cva"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/apps/auth/src/login/**"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "a11y": {
            "noAutofocus": "off",
            "noPositiveTabindex": "off",
            "useIframeTitle": "off",
            "useAltText": "off",
            "useAriaPropsSupportedByRole": "off",
            "noLabelWithoutControl": "off"
          },
          "suspicious": {
            "noShadowRestrictedNames": "off",
            "noExplicitAny": "off",
            "noDoubleEquals": "off",
            "noArrayIndexKey": "off"
          },
          "complexity": {
            "noUselessFragments": "off",
            "useLiteralKeys": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useJsxKeyInIterable": "off"
          }
        }
      }
    },
    {
      "includes": ["**/packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useAriaPropsForRole": "off",
            "noRedundantRoles": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/packages/uim/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessFragments": "off"
          },
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
